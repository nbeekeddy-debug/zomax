# Public canonical site URL used by metadata, sitemap, robots and structured data.
NEXT_PUBLIC_SITE_URL=https://zomax.vercel.app

# Frontend auth mode.
# Use `preview` only while Zomax is intentionally running without a real auth backend.
# Remove it or set `production` before launch so fake frontend sessions fail closed.
NEXT_PUBLIC_ZOMAX_AUTH_MODE=preview

# Secure account backend (Supabase Auth)
# Add these in Vercel Project Settings -> Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Product/catalog backend origin, e.g. https://api.example.com
# Zomax calls ${ZOMAX_API_URL}/api/products and fails safely to the seed catalog.
ZOMAX_API_URL=

# Then enable the auth providers you want in Supabase Auth:
# - Email/password
# - Phone (SMS OTP)
# - Google
# - Apple
